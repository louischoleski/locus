{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "locus-registry-header-0.1",
  "title": "Locus Registry Header",
  "description": "A vehicle or component header in the Locus registry. Every value-bearing field must carry a grade.",
  "type": "object",
  "required": ["id", "kind", "capacity", "accepts", "tropism", "redosable", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*/[a-zA-Z_][a-zA-Z0-9_]*$",
      "description": "Namespaced identity: namespace/name"
    },
    "kind": {
      "type": "string",
      "enum": ["vehicle"]
    },
    "capacity": {
      "type": "object",
      "required": ["nominal_kb", "soft_limit_kb", "grade"],
      "additionalProperties": false,
      "properties": {
        "nominal_kb": { "type": "number", "minimum": 0 },
        "soft_limit_kb": { "type": "number", "minimum": 0 },
        "grade": { "$ref": "#/$defs/grade" }
      }
    },
    "accepts": {
      "type": "array",
      "items": { "type": "string", "enum": ["transgene", "nuclease"] }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tropism": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "level", "grade", "source"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string" },
          "level": { "type": "string", "enum": ["high", "moderate", "low", "none"] },
          "grade": { "$ref": "#/$defs/grade" },
          "source": { "type": "string" }
        }
      }
    },
    "redosable": {
      "type": "object",
      "required": ["value", "grade"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "boolean" },
        "grade": { "$ref": "#/$defs/grade" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["extracted_by", "reviewed_by", "date"],
      "additionalProperties": false,
      "properties": {
        "extracted_by": { "type": ["string", "null"] },
        "reviewed_by": { "type": ["string", "null"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  },
  "$defs": {
    "grade": {
      "type": "object",
      "required": ["m", "o"],
      "additionalProperties": false,
      "properties": {
        "m": {
          "type": "string",
          "enum": ["computed", "measured", "inferred", "asserted", "unknown"]
        },
        "o": {
          "type": ["string", "null"],
          "description": "Organism name or null for organism-independent (n/a)"
        }
      }
    }
  }
}
